{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dotenvx-gui",
  "version": "0.1.0",
  "identifier": "com.dotenvx-gui.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dotenvx",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/onepassword-bridge.cjs": "onepassword-bridge.cjs",
      "../scripts/onepassword-file-ids.cjs": "onepassword-file-ids.cjs",
      "../scripts/onepassword-match.cjs": "onepassword-match.cjs",
      "../scripts/onepassword-save.cjs": "onepassword-save.cjs",
      "../node_modules/@1password/sdk/": "node_modules/@1password/sdk/",
      "../node_modules/@1password/sdk-core/": "node_modules/@1password/sdk-core/"
    }
  }
}
